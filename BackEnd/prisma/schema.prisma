// Schema do ARGOS IA LOGISTIC

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TipoPatio {
  COLETA
  RECEBIMENTO
}

enum TipoOperacao {
  NORMAL
  TRANSFERENCIA
  FILIAL
}

enum OrigemTicket {
  AUTOMATICO
  MANUAL
}

enum TicketStatus {
  CRIADO
  EM_DESLOCAMENTO
  NA_PORTARIA
  EM_ANALISE_RISCO
  BLOQUEADO
  AGUARDANDO_MOTORISTA
  AGUARDANDO_DOCA
  EM_DOCA
  LIBERADO_SAIDA
  EM_TRANSITO
  ENCERRADO
  CANCELADO
}

enum TipoVeiculo {
  CAVALO
  CARRETA
}

enum TipoFrota {
  PROPRIA
  TERCEIRA
}

enum DocaTipo {
  COLETA
  RECEBIMENTO
}

enum DocaStatus {
  LIVRE
  OCUPADA
  MANUTENCAO
}

enum AcessoStatus {
  AGUARDANDO_DADOS
  EM_ANALISE
  LINK_ENVIADO
  LIBERADO
  SAIU
  BLOQUEADO
}

enum AnaliseRiscoStatus {
  APROVADO
  REPROVADO
}

enum RomaneioStatus {
  EM_MONTAGEM
  CONFERIDO
  LIBERADO
  FINALIZADO
}

enum EntregaStatus {
  PROGRAMADA
  EM_ROTA
  ENTREGUE
  PARCIAL
  RECUSADA
  DESTINATARIO_AUSENTE
  INSUCESSO
}

enum TipoOcorrencia {
  DIVERGENCIA
  ATRASO
  AVARIA
  RISCO
  PLACA_DIVERGENTE
  OUTRO
}

enum CanalNotificacao {
  SMS
  WHATSAPP
}

model Cliente {
  id           String   @id @default(cuid())
  cnpj         String   @unique
  razaoSocial  String
  nomeFantasia String?
  cidade       String?
  uf           String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notasEmitidas      NotaFiscal[] @relation("NotaEmitente")
  notasDestinatarias NotaFiscal[] @relation("NotaDestinatario")
}

model NotaFiscal {
  id            String       @id @default(cuid())
  chave         String       @unique
  numero        String
  serie         String?
  volumes       Int
  peso          Decimal      @db.Decimal(12, 3)
  placa         String?
  cfop          String?
  tipoPatio     TipoPatio
  operacao      TipoOperacao @default(NORMAL)
  origemSistema String?
  motivoTriagem String?

  emitenteId     String
  emitente       Cliente @relation("NotaEmitente", fields: [emitenteId], references: [id])
  destinatarioId String
  destinatario   Cliente @relation("NotaDestinatario", fields: [destinatarioId], references: [id])

  ticketId   String?
  ticket     Ticket?   @relation(fields: [ticketId], references: [id])
  romaneioId String?
  romaneio   Romaneio? @relation(fields: [romaneioId], references: [id])
  entregas   Entrega[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([romaneioId])
  @@index([placa])
}

model Ticket {
  id            String       @id @default(cuid())
  codigo        String       @unique
  status        TicketStatus @default(CRIADO)
  origem        OrigemTicket
  frota         TipoFrota?
  tipoPatio     TipoPatio?
  motivoTriagem String?
  observacoes   String?

  notas        NotaFiscal[]
  eventos      EventoTicket[]
  acessos      AcessoPortaria[]
  analises     AnaliseRisco[]
  alocacoes    AlocacaoDoca[]
  filas        FilaDoca[]
  romaneios    Romaneio[]
  posicoes     PosicaoVeiculo[]
  ocorrencias  Ocorrencia[]
  notificacoes Notificacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([frota])
  @@index([tipoPatio])
}

model EventoTicket {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tipo      String
  descricao String
  dados     Json?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model Veiculo {
  id              String      @id @default(cuid())
  placa           String      @unique
  tipo            TipoVeiculo
  frota           TipoFrota
  restricao       Boolean     @default(false)
  motivoRestricao String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  acessosCavalo  AcessoPortaria[] @relation("AcessoCavalo")
  acessosCarreta AcessoPortaria[] @relation("AcessoCarreta")
  posicoes       PosicaoVeiculo[]
}

model Motorista {
  id              String    @id @default(cuid())
  nome            String
  cpf             String    @unique
  telefone        String
  cnhNumero       String?
  cnhValidade     DateTime?
  restricao       Boolean   @default(false)
  motivoRestricao String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  acessos AcessoPortaria[]
}

model AcessoPortaria {
  id            String       @id @default(cuid())
  ticketId      String
  ticket        Ticket       @relation(fields: [ticketId], references: [id])
  cavaloId      String
  cavalo        Veiculo      @relation("AcessoCavalo", fields: [cavaloId], references: [id])
  carretaId     String?
  carreta       Veiculo?     @relation("AcessoCarreta", fields: [carretaId], references: [id])
  motoristaId   String?
  motorista     Motorista?   @relation(fields: [motoristaId], references: [id])
  status        AcessoStatus @default(AGUARDANDO_DADOS)
  somenteCavalo Boolean      @default(false)
  token         String?      @unique
  tokenValidade DateTime?
  tokenUsado    Boolean      @default(false)
  entradaEm     DateTime?
  saidaEm       DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  analises     AnaliseRisco[]
  notificacoes Notificacao[]

  @@index([ticketId])
  @@index([status])
}

model AnaliseRisco {
  id        String             @id @default(cuid())
  ticketId  String
  ticket    Ticket             @relation(fields: [ticketId], references: [id])
  acessoId  String
  acesso    AcessoPortaria     @relation(fields: [acessoId], references: [id], onDelete: Cascade)
  status    AnaliseRiscoStatus
  score     Int
  motivos   Json
  createdAt DateTime           @default(now())

  @@index([ticketId])
  @@index([acessoId])
}

model Doca {
  id        String     @id @default(cuid())
  numero    Int        @unique
  tipo      DocaTipo
  status    DocaStatus @default(LIVRE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  alocacoes AlocacaoDoca[]

  @@index([tipo, status])
}

model AlocacaoDoca {
  id        String    @id @default(cuid())
  ticketId  String
  ticket    Ticket    @relation(fields: [ticketId], references: [id])
  docaId    String
  doca      Doca      @relation(fields: [docaId], references: [id])
  entradaEm DateTime  @default(now())
  saidaEm   DateTime?

  @@unique([ticketId, saidaEm])
  @@index([docaId, saidaEm])
}

model FilaDoca {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  tipo      DocaTipo
  posicao   Int
  createdAt DateTime @default(now())

  @@unique([ticketId, tipo])
  @@index([tipo, posicao])
}

model Romaneio {
  id                String         @id @default(cuid())
  codigo            String         @unique
  ticketId          String
  ticket            Ticket         @relation(fields: [ticketId], references: [id])
  status            RomaneioStatus @default(EM_MONTAGEM)
  volumesPrevistos  Int            @default(0)
  volumesConferidos Int?
  pesoPrevisto      Decimal        @default(0) @db.Decimal(12, 3)
  pesoConferido     Decimal?       @db.Decimal(12, 3)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  notas       NotaFiscal[]
  entregas    Entrega[]
  ocorrencias Ocorrencia[]
}

model Entrega {
  id               String        @id @default(cuid())
  romaneioId       String
  romaneio         Romaneio      @relation(fields: [romaneioId], references: [id])
  notaFiscalId     String
  notaFiscal       NotaFiscal    @relation(fields: [notaFiscalId], references: [id])
  sequencia        Int
  status           EntregaStatus @default(PROGRAMADA)
  volumesPrevistos Int
  volumesEntregues Int?
  recebedorNome    String?
  recebedorDoc     String?
  comprovanteUrl   String?
  baixadaEm        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([romaneioId, notaFiscalId])
  @@index([romaneioId, sequencia])
}

model PosicaoVeiculo {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  veiculoId   String
  veiculo     Veiculo  @relation(fields: [veiculoId], references: [id])
  latitude    Float
  longitude   Float
  velocidade  Float?
  etaMinutos  Int?
  distanciaKm Float?
  createdAt   DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([veiculoId, createdAt])
}

model Ocorrencia {
  id         String         @id @default(cuid())
  ticketId   String
  ticket     Ticket         @relation(fields: [ticketId], references: [id])
  romaneioId String?
  romaneio   Romaneio?      @relation(fields: [romaneioId], references: [id])
  tipo       TipoOcorrencia
  descricao  String
  dados      Json?
  resolvida  Boolean        @default(false)
  createdAt  DateTime       @default(now())

  @@index([ticketId])
  @@index([tipo, resolvida])
}

model Notificacao {
  id        String           @id @default(cuid())
  ticketId  String?
  ticket    Ticket?          @relation(fields: [ticketId], references: [id])
  acessoId  String?
  acesso    AcessoPortaria?  @relation(fields: [acessoId], references: [id])
  canal     CanalNotificacao
  destino   String
  mensagem  String
  enviadaEm DateTime         @default(now())

  @@index([ticketId])
  @@index([acessoId])
}
